ue v, bool pv, Bound b, Depth d, Move m, Value ev, uint8_t generation8);\n+    void penalize(int penalty);  // decrement stored depth by the penalty\n \n    private:\n     friend class TranspositionTable;\n     TTEntry* entry;\n",
